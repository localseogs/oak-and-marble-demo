---
import { company } from '../data/home';
import { isCurrent, sitePath } from '../lib/site-path';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-slide style="--delay: 0.12s">
	<div class="footer-layout">
		<div class="footer-side">
			<a href={sitePath('/#inquire')}>Contact us</a>
			<a href={`mailto:${company.email}`}>{company.email}</a>
		</div>
		<nav class="footer-links" aria-label="Footer">
			<a href={sitePath('/#services')}>What We Do</a>
			<a href={sitePath('/#about')}>Our Story</a>
			<a href={sitePath('/#process')}>Our Process</a>
			<a href={sitePath('/#work')}>Our Work</a>
			<a href={sitePath('/costs-guide')} aria-current={isCurrent(Astro.url.pathname, '/costs-guide') ? 'page' : undefined}>Costs Guide</a>
			<a href={sitePath('/#inquire')}>Inquire</a>
		</nav>
		<a class="footer-top" href={sitePath('/')} aria-label="Back to start">
			<span class="footer-top-arrow" aria-hidden="true"></span>
		</a>
	</div>
	<p class="footer-note">Copyright {year} Oak &amp; Marble</p>
</footer>

<script>
	import { isCurrent } from '../lib/site-path';

	const toTop = document.querySelector('.footer-top');

	toTop?.addEventListener('click', (event) => {
		if (!isCurrent(window.location.pathname, '/')) return;
		event.preventDefault();
		window.scrollTo({ top: 0, behavior: 'auto' });
	});
</script>
